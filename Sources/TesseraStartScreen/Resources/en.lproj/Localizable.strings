/*
  Localizable.strings (English) — default user-facing strings of TesseraStartScreen.

  The default strings live in SPM resources rather than in Swift literals.
  Keys are stable identifiers shared by the en and ru tables; only the values
  are translated. Do not rename a key without updating TesseraStartScreenStrings.Key
  and the parity tests (Tests/TesseraStartScreenTests/LocalizationTests.swift).

  Placeholders: %1$@ is a string, %1$ld is an integer.
*/

/* MARK: - Editing mode (VoiceOver) */

/* Entering editing mode. */
"a11y.editing.entered" = "Editing mode.";

/* Leaving editing mode. */
"a11y.editing.exited" = "Editing mode finished.";

/* A shortcut was unpinned from the Start screen. */
"a11y.tile.unpinned" = "Shortcut unpinned.";

/* New tile size: %1$@ is the size name. */
"a11y.resize.format" = "Size: %1$@.";

/* Size names for VoiceOver announcements. */
"a11y.size.small" = "small";
"a11y.size.medium" = "medium";
"a11y.size.wide" = "wide";
"a11y.size.large" = "large";

/* MARK: - Folders (VoiceOver) */

/* A folder was created. */
"a11y.folder.created" = "Folder created.";

/* A shortcut was added to a folder. */
"a11y.folder.tileAdded" = "Shortcut added to the folder.";

/* A shortcut was moved to another folder. */
"a11y.folder.tileMoved" = "Shortcut moved to the folder.";

/* A shortcut was moved out of a folder onto the Start screen. */
"a11y.folder.tileOnStart" = "Shortcut on the Start screen.";

/* The host's approval function denied a folder operation. */
"a11y.folder.unavailable" = "Folder operation unavailable.";

/* A folder was created by dragging one shortcut onto another. */
"a11y.folder.createdFromTwoTiles" = "Folder created from two shortcuts.";

/* MARK: - Dragging (VoiceOver) */

/* An external model change cancelled the drag. */
"a11y.drag.cancelled" = "Drag cancelled: the state has changed.";

/* Hovering over a folder: releasing adds the shortcut to the folder. */
"a11y.drag.holdToAddToFolder" = "Release to add the shortcut to the folder.";

/* Hovering over the center of a shortcut: releasing creates a folder. */
"a11y.drag.holdToCreateFolder" = "Release to create a folder.";

/* MARK: - Approval function denial (D14) */

/* Template for the denial message: %1$@ is the reason (see a11y.grouping.reason.*). */
"a11y.grouping.failedFormat" = "Failed: %1$@.";

/* Reasons the approval function can deny an operation. */
"a11y.grouping.reason.addDenied" = "adding to a folder is denied";
"a11y.grouping.reason.createDenied" = "creating a folder is denied";
"a11y.grouping.reason.tileAddDenied" = "adding the shortcut to the new folder is denied";
"a11y.grouping.reason.moveDenied" = "moving the shortcut is denied";

