/* Action: unpin a shortcut. */
"a11y.action.unpin" = "Unpin";

/* Action: change the tile size. */
"a11y.action.resize" = "Change size";

/* Action: rename a folder (folder tile and open panel header; D35). */
"a11y.action.renameFolder" = "Rename";

/* Action: add a shortcut to a folder (%@ is the folder title). */
